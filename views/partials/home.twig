<main class="min-h-dvh bg-white font-sans text-neutral-900">

  <!-- TOP LANGUAGE NAVIGATION -->
  <nav class="bg-neutral-50 border-b border-neutral-200 py-4">
    <div class="max-w-4xl mx-auto px-4 flex justify-center gap-6">
      <a href="https://dev.fwbchurch.org/home/en/northwest-church/" class="text-sm font-display font-bold text-primary-600 hover:text-primary-700 transition-colors uppercase tracking-widest">
        English Website
      </a>
      <span class="text-neutral-300">|</span>
      <a href="https://dev.fwbchurch.org/home/es/northwest-iglesia/" class="text-sm font-display font-bold text-primary-600 hover:text-primary-700 transition-colors uppercase tracking-widest">
        Sitio en Español
      </a>
    </div>
  </nav>

  <!-- HERO SECTION WITH BACKGROUND IMAGE -->
  <header class="relative py-24 text-center overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img src="your-image-path.jpg" alt="Northwest Church Background" class="size-full object-cover">
      <div class="absolute inset-0 bg-neutral-900/60 bg-linear-to-b from-neutral-900/80 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4">
      <h1 class="font-display text-5xl/tight font-bold text-white mb-4 drop-shadow-sm">
        Northwest Church <span class="block text-primary-300">Iglesia Northwest</span>
      </h1>
      
      <div class="size-1.5 bg-gold-500 mx-auto rounded-full mb-12"></div>

      <!-- INTERACTIVE BILINGUAL GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16">
        
        <!-- Interactive List Item Helper (English -> Spanish) -->
        <div class="flex flex-col gap-4 text-white">
          <ul class="flex flex-col gap-2 font-display font-bold text-2xl uppercase tracking-wide">
            <li class="group relative cursor-default">
              <span class="inline-block transition-all duration-300 group-hover:opacity-0 group-hover:-translate-y-2">One God.</span>
              <span class="absolute left-0 top-0 text-primary-300 opacity-0 transition-all duration-300 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0">Un solo Dios.</span>
            </li>
            <li class="group relative cursor-default">
              <span class="inline-block transition-all duration-300 group-hover:opacity-0 group-hover:-translate-y-2">One family.</span>
              <span class="absolute left-0 top-0 text-primary-300 opacity-0 transition-all duration-300 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0">Una sola familia.</span>
            </li>
            <li class="group relative cursor-default">
              <span class="inline-block transition-all duration-300 group-hover:opacity-0 group-hover:-translate-y-2">One church.</span>
              <span class="absolute left-0 top-0 text-primary-300 opacity-0 transition-all duration-300 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0">Una sola iglesia.</span>
            </li>
          </ul>
        </div>

        <div class="flex flex-col gap-4 text-white">
          <ul class="flex flex-col gap-2 font-display font-bold text-2xl uppercase tracking-wide">
            <li class="group relative cursor-default">
              <span class="inline-block transition-all duration-300 group-hover:opacity-0 group-hover:-translate-y-2">One race.</span>
              <span class="absolute left-0 top-0 text-primary-300 opacity-0 transition-all duration-300 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0">Una sola raza.</span>
            </li>
            <li class="group relative cursor-default">
              <span class="inline-block transition-all duration-300 group-hover:opacity-0 group-hover:-translate-y-2">One worship service.</span>
              <span class="absolute left-0 top-0 text-primary-300 opacity-0 transition-all duration-300 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0">Un solo servicio.</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </header>

  <!-- BILINGUAL VERSE & CTA SECTION -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 text-center">
      
      <!-- Flipping Verse -->
      <div class="group relative h-24 flex items-center justify-center mb-12">
        <p class="absolute inset-0 text-2xl/9 text-neutral-700 font-serif italic transition-all duration-500 group-hover:opacity-0 group-hover:scale-95">
          "My house will be called a house of prayer for all nations." <span class="block mt-2 font-sans not-italic text-sm font-bold uppercase tracking-widest text-neutral-400">— Mark 11:17</span>
        </p>
        <p class="absolute inset-0 text-2xl/9 text-primary-700 font-serif italic opacity-0 transition-all duration-500 scale-105 group-hover:opacity-100 group-hover:scale-100">
          "Mi casa será llamada casa de oración para todas las naciones." <span class="block mt-2 font-sans not-italic text-sm font-bold uppercase tracking-widest text-primary-400">— Marcos 11:17</span>
        </p>
      </div>

      <!-- Philosophy CTA -->
      <div class="flex flex-col items-center gap-6">
        <div class="h-px w-24 bg-gold-500/50"></div>
        <h3 class="font-display text-xl font-bold text-neutral-900">Unity in Worship</h3>
        <p class="text-neutral-600 mb-4">Discover why we choose to worship together as one multicultural family.</p>
        <a href="/philosophy-joint-worship" class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-display font-bold py-4 px-10 rounded-church shadow-sm hover:shadow-md transition-all uppercase tracking-wider text-sm">
          Our Joint Worship Philosophy
        </a>
      </div>

    </div>
  </section>

  <!-- FOOTER SITES -->
  <footer class="py-12 bg-neutral-900 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/en/" class="border border-white/20 hover:bg-white/10 text-white font-display font-bold py-3 px-6 rounded-church transition-all text-sm uppercase">
          Enter English Site
        </a>
        <a href="/es/" class="border border-white/20 hover:bg-white/10 text-white font-display font-bold py-3 px-6 rounded-church transition-all text-sm uppercase">
          Sitio en Español
        </a>
      </div>
    </div>
  </footer>

</main>