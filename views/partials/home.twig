{# Northwest Home Page Template #}
<main class="min-h-dvh bg-white font-sans text-neutral-900">

  <!-- TOP CALL TO ACTION -->
  <nav class="bg-neutral-50 border-b border-neutral-200 py-4">
    <div class="max-w-4xl mx-auto px-4 flex justify-center gap-6">
      <a href="https://dev.fwbchurch.org/home/en/northwest-church/" class="text-sm font-display font-bold text-primary-600 hover:text-primary-700 transition-colors uppercase tracking-widest">
        English Website
      </a>
      <span class="text-neutral-300">|</span>
      <a href="https://dev.fwbchurch.org/home/es/northwest-iglesia/" class="text-sm font-display font-bold text-primary-600 hover:text-primary-700 transition-colors uppercase tracking-widest">
        Sitio en Español
      </a>
    </div>
  </nav>

  <!-- HERO SECTION WITH BACKGROUND -->
  {# Increased height to h-[700px] and darkened the overlay for legibility #}
  <header class="relative flex items-center justify-center h-[700px] text-center overflow-hidden">
    <!-- Background Image with Heavy Dark Overlay -->
    <div class="absolute inset-0 z-0">
      <img src="{{ theme.link }}/assets/images/church-hero.jpg" alt="Northwest Church" class="size-full object-cover">
      {# Uses neutral-900 with 70% opacity for a deep, cinematic dark look #}
      <div class="absolute inset-0 bg-neutral-900/70"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4">
      {# Significantly larger Northwest Church title using text-7xl #}
      <h1 class="font-display text-6xl md:text-8xl font-bold text-white mb-6 drop-shadow-md">
        Northwest Church 
        <span class="block text-primary-400 text-4xl md:text-6xl mt-2">Iglesia Northwest</span>
      </h1>
      
      <div class="size-2 bg-gold-500 mx-auto rounded-full mb-16"></div>

      <!-- BILINGUAL FLIP GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-24 gap-y-8 text-left max-w-4xl mx-auto">
        
        {# Macro-like structure for the flipping list items #}
        <div class="flex flex-col gap-4">
          <ul class="flex flex-col gap-4 font-display font-bold text-3xl md:text-4xl text-white uppercase tracking-tight">
            
            {# English -> Spanish Hover Item #}
            <li class="group relative cursor-default overflow-hidden">
              <div class="transition-all duration-500 group-hover:-translate-y-full group-hover:opacity-0">One God.</div>
              <div class="absolute inset-0 text-primary-300 opacity-0 translate-y-full transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">Un solo Dios.</div>
            </li>

            <li class="group relative cursor-default overflow-hidden">
              <div class="transition-all duration-500 group-hover:-translate-y-full group-hover:opacity-0">One family.</div>
              <div class="absolute inset-0 text-primary-300 opacity-0 translate-y-full transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">Una sola familia.</div>
            </li>

            <li class="group relative cursor-default overflow-hidden">
              <div class="transition-all duration-500 group-hover:-translate-y-full group-hover:opacity-0">One church.</div>
              <div class="absolute inset-0 text-primary-300 opacity-0 translate-y-full transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">Una sola iglesia.</div>
            </li>
          </ul>
        </div>

        <div class="flex flex-col gap-4">
          <ul class="flex flex-col gap-4 font-display font-bold text-3xl md:text-4xl text-white uppercase tracking-tight">
            <li class="group relative cursor-default overflow-hidden">
              <div class="transition-all duration-500 group-hover:-translate-y-full group-hover:opacity-0">One race.</div>
              <div class="absolute inset-0 text-primary-300 opacity-0 translate-y-full transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">Una sola raza.</div>
            </li>

            <li class="group relative cursor-default overflow-hidden">
              <div class="transition-all duration-500 group-hover:-translate-y-full group-hover:opacity-0">One worship.</div>
              <div class="absolute inset-0 text-primary-300 opacity-0 translate-y-full transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">Un solo culto.</div>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </header>

  <!-- VERSE SECTION -->
  <section class="py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      
      {# Flipping Verse with fixed height to prevent content jump #}
      <div class="group relative h-32 md:h-24 flex items-center justify-center mb-16 cursor-help">
        <p class="absolute transition-all duration-700 text-2xl/10 md:text-3xl/10 text-neutral-700 font-serif italic group-hover:opacity-0 group-hover:scale-95 group-hover:-translate-y-4">
          "My house will be called a house of prayer for all nations." 
          <span class="block text-sm font-sans not-italic font-bold text-neutral-400 mt-2">— Mark 11:17</span>
        </p>
        <p class="absolute opacity-0 scale-105 translate-y-4 transition-all duration-700 text-2xl/10 md:text-3xl/10 text-primary-700 font-serif italic group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0">
          "Mi casa será llamada casa de oración para todas las naciones."
          <span class="block text-sm font-sans not-italic font-bold text-neutral-400 mt-2">— Marcos 11:17</span>
        </p>
      </div>

      <!-- JOINT WORSHIP CTA -->
      <div class="flex flex-col items-center gap-6">
        <h2 class="font-display text-2xl font-bold text-neutral-900 uppercase tracking-widest">Our Shared Philosophy</h2>
        <p class="text-lg text-neutral-600 max-w-2xl">We believe that worshipping in two languages simultaneously is a prophetic picture of the Kingdom of Heaven.</p>
        <a href="/joint-worship-philosophy" class="bg-primary-600 hover:bg-primary-700 text-white font-display font-bold py-5 px-12 rounded-church transition-all shadow-lg hover:shadow-primary-500/20 uppercase tracking-widest text-sm">
          Learn about Joint Worship
        </a>
      </div>

    </div>
  </section>

</main>