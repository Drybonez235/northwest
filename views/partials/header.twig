<header class="bg-white border-b border-neutral-100 font-sans sticky top-0 z-50" x-data="{ 
    mobileMenuOpen: false, 
    activePanel: 'main' 
}">
  <div class="container mx-auto px-4 flex items-center justify-between h-20">
    
     {# Logo and Church Name Wrapper #}
      <div class="flex items-center gap-4">
        <div class="site-logo">
    {# Define the home link based on the detected language #}
    {% set home_link = (lang == 'es') 
        ? 'https://dev.fwbchurch.org/home/es/northwest-iglesia/' 
        : 'https://dev.fwbchurch.org/home/en/northwest-church/' 
    %}

    {% if custom_logo_url %}
        <a href="{{ home_link }}">
            <img src="{{ custom_logo_url }}" alt="{{ theme.name }}" class="h-12 w-auto">
        </a>
    {% else %}
        <h1 class="text-xl/7 font-display font-bold text-neutral-900">
            <a href="{{ home_link }}">{{ theme.name }}</a>
        </h1>
    {% endif %}
</div>

        <h2 class="text-lg/6 font-semibold text-gray-800">
            {{ theme.name }}
        </h2>
    </div>

    {# Desktop Navigation #}
    <nav class="hidden md:flex items-center gap-8">
       
        {# Dynamic Events Dropdown #}
<div class="group relative py-4">
  <button class="flex items-center gap-1 text-sm font-bold uppercase tracking-wider text-neutral-700 group-hover:text-primary-600 transition-colors cursor-pointer">
    {{ lang == 'es' ? 'Eventos' : 'Events' }}
    <svg class="size-4 opacity-40 group-hover:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  {# Dropdown Menu #}
  <div class="absolute top-full right-0 w-64 bg-white shadow-sm border border-neutral-100 rounded-church py-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
    {% for event in nav_events %}
      <a href="{{ event.link }}" class="block px-6 py-2.5 hover:bg-neutral-50 group/item">
        <span class="block text-sm font-bold text-neutral-800 group-hover/item:text-primary-600">
          {# Pulls the custom Event Title meta, falls back to WP Post Title #}
          {{ event.meta('nw_event_title') ?: event.title }}
        </span>

      </a>
    {% endfor %}
    
    {% if nav_events is empty %}
      <div class="px-6 py-2.5 text-xs italic text-neutral-400">
        {{ lang == 'es' ? 'No hay eventos' : 'No events found' }}
      </div>
    {% endif %}
  </div>
</div>
      {# Dynamic Ministries Dropdown #}
      <div class="group relative py-4">
        <button class="flex items-center gap-1 text-sm font-bold uppercase tracking-wider text-neutral-700 group-hover:text-primary-600 transition-colors cursor-pointer">
          {{ lang == 'es' ? 'Ministerios' : 'Ministries' }}
          <svg class="size-4 opacity-40 group-hover:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        {# Dropdown Menu #}
        <div class="absolute top-full right-0 w-64 bg-white shadow-sm border border-neutral-100 rounded-church py-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
          {% for ministry in nav_ministries %}
            <a href="{{ ministry.link }}" class="block px-6 py-2.5 hover:bg-neutral-50 group/item">
              <span class="block text-sm font-bold text-neutral-800 group-hover/item:text-primary-600">
                {# Uses Title Name meta, falls back to Post Title #}
                {{ ministry.meta('_ministry_title_name') ?: ministry.title }}
              </span>
            </a>
          {% endfor %}
          
        </div>
      </div>
      {# Regular Posts Dropdown #}
  <div class="group relative flex items-center h-full">
    <button class="flex items-center gap-1 text-sm font-bold uppercase tracking-wider text-neutral-700 group-hover:text-primary-600 transition-colors cursor-pointer">
      {{ lang == 'es' ? 'Sobre Nosotros' : 'About Us' }}
      <svg class="size-4 opacity-40 group-hover:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    {# Dropdown Menu - Aligned Right to stay on screen #}
    <div class="absolute top-full right-0 w-72 bg-white shadow-md border border-neutral-100 rounded-church py-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-">
      {% for post in nav_posts %}
        <a href="{{ post.link }}" class="block px-6 py-3 hover:bg-neutral-50 group/item transition-colors">
          <span class="block text-sm/5 font-bold text-neutral-800 group-hover/item:text-primary-600">
            {{ post.title }}
          </span>
        </a>
      {% endfor %}
    </nav>
  </div>

  {# Hamburger Button #}
    <button 
      @click="mobileMenuOpen = true; activePanel = 'main'" 
      class="md:hidden p-2 text-neutral-700"
      aria-label="Open Menu"
    >
      <svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  {# Mobile Full-Screen Overlay #}
  <div 
    x-show="mobileMenuOpen" 
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    class="fixed inset-0 z-100 bg-white min-h-dvh flex flex-col md:hidden"
  >
    {# Mobile Header (Back/Close) #}
    <div class="flex items-center justify-between px-6 h-20 border-b border-neutral-100">
      <template x-if="activePanel !== 'main'">
        <button @click="activePanel = 'main'" class="flex items-center gap-2 text-primary-600 font-bold uppercase tracking-wider text-sm">
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M15 19l-7-7 7-7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {{ lang == 'es' ? 'Volver' : 'Back' }}
        </button>
      </template>
      <div x-show="activePanel === 'main'">
        <span class="font-display font-bold text-neutral-900 uppercase tracking-widest text-sm">Menu</span>
      </div>
      
      <button @click="mobileMenuOpen = false" class="p-2 text-neutral-500">
        <svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M6 18L18 6M6 6l12 12" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    {# Panels Container #}
    <div class="flex-1 overflow-y-auto px-6 py-8">
      
      {# MAIN PANEL #}
      <div x-show="activePanel === 'main'" class="flex flex-col gap-6">
        <button @click="activePanel = 'events'" class="flex items-center justify-between w-full text-2xl font-bold text-neutral-800">
          {{ lang == 'es' ? 'Eventos' : 'Events' }}
          <svg class="size-6 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        
        <button @click="activePanel = 'ministries'" class="flex items-center justify-between w-full text-2xl font-bold text-neutral-800">
          {{ lang == 'es' ? 'Ministerios' : 'Ministries' }}
          <svg class="size-6 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <button @click="activePanel = 'about'" class="flex items-center justify-between w-full text-2xl font-bold text-neutral-800">
          {{ lang == 'es' ? 'Sobre Nosotros' : 'About Us' }}
          <svg class="size-6 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      {# EVENTS PANEL #}
      <div x-show="activePanel === 'events'" class="flex flex-col gap-4">
        <h3 class="text-xs font-bold uppercase tracking-widest text-primary-500 mb-2">{{ lang == 'es' ? 'Próximos Eventos' : 'Upcoming Events' }}</h3>
        {% for event in nav_events %}
          <a href="{{ event.link }}" class="block py-4 border-b border-neutral-50">
            <span class="text-xl font-bold text-neutral-800">{{ event.meta('nw_event_title') ?: event.title }}</span>
          </a>
        {% endfor %}
      </div>

      {# MINISTRIES PANEL #}
      <div x-show="activePanel === 'ministries'" class="flex flex-col gap-4">
        <h3 class="text-xs font-bold uppercase tracking-widest text-primary-500 mb-2">{{ lang == 'es' ? 'Nuestros Ministerios' : 'Our Ministries' }}</h3>
        {% for ministry in nav_ministries %}
          <a href="{{ ministry.link }}" class="block py-4 border-b border-neutral-50">
            <span class="text-xl font-bold text-neutral-800">{{ ministry.meta('_ministry_title_name') ?: ministry.title }}</span>
          </a>
        {% endfor %}
      </div>

      {# ABOUT PANEL #}
      <div x-show="activePanel === 'about'" class="flex flex-col gap-4">
        <h3 class="text-xs font-bold uppercase tracking-widest text-primary-500 mb-2">{{ lang == 'es' ? 'Conócenos' : 'Get to Know Us' }}</h3>
        {% for post in nav_posts %}
          <a href="{{ post.link }}" class="block py-4 border-b border-neutral-50">
            <span class="text-xl font-bold text-neutral-800">{{ post.title }}</span>
          </a>
        {% endfor %}
      </div>
</header>